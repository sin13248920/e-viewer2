<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>월간서오 e뷰어</title>

<style>
html, body {
  margin: 0;
  height: 100%;
  background: #f5f5f5;
  font-family: 'Segoe UI', sans-serif;
}

#app {
  width: 100%;
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

/* HEADER */
.header {
  padding: 10px 20px;
  border-bottom: 1px solid #ddd;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header img {
  height: 50px;
}

.header-text {
  font-size: 14px;
  color: black;
}

/* CONTENT */
.content {
  flex: 1;
}

.grid {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 60px;
  min-height: 60vh;
  padding-top: 40px;
}

/* CARD */
.card {
  width: 200px;
  cursor: pointer;
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: scale(1.08);
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.card:active {
  transform: scale(0.95);
}

.card img {
  width: 100%;
  border-radius: 10px;
}

.card p {
  text-align: center;
}

/* BADGE */
.badge, .badge-coming {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 4px 8px;
  font-size: 12px;
  border-radius: 8px;
  color: white;
}

.badge { background: red; }
.badge-coming { background: gray; }

/* FOOTER */
.footer {
  padding: 10px;
  background: #fafafa;
  border-top: 1px solid #ddd;
  font-size: 12px;
  text-align: center;
}

.footer p {
  margin: 2px 0;
}

.footer img {
  height: 30px;
  margin-bottom: 5px;
}

/* MOBILE */
@media (max-width: 768px) {
  .grid {
    flex-direction: column;
    gap: 30px;
  }

  .card {
    width: 70%;
  }

  .header img {
    height: 40px;
  }

  .header-text {
    font-size: 12px;
  }
}
</style>
</head>

<body>

<div id="app">

  <!-- HEADER -->
  <div class="header">
    <img src="https://drive.google.com/thumbnail?id=1lFUKv4ZpRblOeLCLD8aUp11aR952kQdj&sz=w1000">
    <div class="header-text">스토리가 있는 서오 전문지</div>
  </div>

  <!-- CONTENT -->
  <div class="content">

    <div class="grid">

      <!-- 2026년 5월 -->
      <div class="card" onclick="location.href='2605.html'">
        <div class="badge">최신호</div>
        <img src="https://drive.google.com/thumbnail?id=1hk7NpBIfWI06E5XDO2oZi5J0ZSnydCk5&sz=w1000">
        <p>2026년 5월호</p>
      </div>

      <!-- 2026년 6월 -->
      <div class="card" onclick="location.href='2606.html'">
        <div class="badge-coming">출간예정</div>
        <img src="https://drive.google.com/thumbnail?id=1OSbIGt3ZwVDYecxrVhHrB_v8R-oVirsd&sz=w1000">
        <p>2026년 6월호</p>
      </div>

    </div>

  </div>

  <!-- FOOTER -->
  <div class="footer">
    <img src="https://drive.google.com/thumbnail?id=1Sr1eMqd6h21-HVOj93iMOohGJ1rAx3or&sz=w500">

    <p>[02565] 서오시 용산구 서오중앙로 34(서오동)</p>

    <p>
      대표번호 : 02-1234-5678 |
      02-0987-6543 |
      02-0987-4321
    </p>

    <p>
      FAX : 02-1234-0987
    </p>
  </div>

</div>

</body>
</html>
